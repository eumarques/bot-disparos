# Token do seu bot (fale com o @BotFather no Telegram para criar um bot e pegar o token)
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui

# Fuso horario usado para os agendamentos
TIMEZONE=America/Sao_Paulo

# Porta do painel web
PORT=5000

# Conta de administrador inicial (criada no primeiro start). Troque a senha!
ADMIN_USER=admin
ADMIN_PASSWORD=troque_esta_senha

# Chave de sessao (opcional). Se deixar vazio, uma sera gerada automaticamente.
SECRET_KEY=
